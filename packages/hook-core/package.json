{
  "name": "@oked/hook-core",
  "version": "0.6.25",
  "description": "Shared OKed approval gate for coding-agent hooks. Builds the request, waits for a decision, checks the receipt, and fails closed.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "npm run build --workspace=@oked/sdk",
    "build": "tsc",
    "test": "npm run build && node src/core.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "oked",
    "ai-agent",
    "approval",
    "human-in-the-loop",
    "hooks",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oked-ai/oked-sdk.git",
    "directory": "packages/hook-core"
  },
  "bugs": {
    "url": "https://github.com/oked-ai/oked-sdk/issues"
  },
  "homepage": "https://oked.ai",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@oked/sdk": "0.6.25"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
