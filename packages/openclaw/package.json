{
  "name": "@oked/openclaw",
  "version": "0.6.25",
  "description": "Pauses risky OpenClaw actions, like rm -rf, force-push, destructive SQL and prod deploys, until you approve them in Telegram or on the OKed web dashboard. Everything else just runs. Every decision gets a signed receipt.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "assets"
  ],
  "scripts": {
    "prebuild": "npm run build --workspace=@oked/sdk",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node src/clawhub-metadata.test.mjs && node src/script-excerpt.test.mjs && node src/smoke.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.4",
      "minGatewayVersion": "2026.5.4"
    },
    "build": {
      "openclawVersion": "2026.5.4"
    },
    "install": {
      "clawhubSpec": "@oked/openclaw",
      "npmSpec": "@oked/openclaw",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.5.4"
    }
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.4"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "dependencies": {
    "@oked/sdk": "0.6.25"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "approval",
    "agents",
    "ai",
    "human-in-the-loop",
    "oked"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oked-ai/oked-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/oked-ai/oked-sdk/issues"
  },
  "homepage": "https://github.com/oked-ai/oked-sdk/tree/main/packages/openclaw#readme",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18",
    "openclaw": ">=2026.5.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
