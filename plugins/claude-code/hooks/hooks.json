{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|Agent|Task|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/oked-hook.mjs\"",
            "timeout": 690,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
